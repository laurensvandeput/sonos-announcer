{
  "name": "sonos-announcer",
  "version": "1.0.0",
  "description": "Direct local Sonos visitor announcements for Home Assistant and Apple Home",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "start:production": "node build/src/index.js",
    "debug": "tsx --inspect=3030 src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.release.json",
    "lint": "eslint src",
    "test": "npm run build && node --import tsx --test --test-timeout=15000 test/*.test.mjs",
    "test:watch": "node --import tsx --test --watch test/*.test.mjs",
    "test:ci": "npm test",
    "speakers": "tsx src/speakers.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.0.0",
    "express": "^4.17.3",
    "helmet": "^8.0.0",
    "winston": "^3.7.2",
    "ws": "^8.22.0",
    "yaml": "^2.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
