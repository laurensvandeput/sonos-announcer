# Leave empty for automatic SSDP discovery (multicast and broadcast).
# Optional override when discovery is blocked, e.g. 10.1.60.156,10.1.60.216.
SONOS_HOSTS=
# Optional: local interface IPv4 address used for discovery, not a speaker IP.
# SONOS_DISCOVERY_INTERFACE=192.168.1.20
# This application's address as reached by the speakers, e.g. http://192.168.1.20:3000
MEDIA_BASE_URL=
CLIP_FILE=./clips/announce.mp3
PORT=3000
TIME_ZONE=Europe/Brussels
SPEAKERS_CONFIG=./config/speakers.yaml
SONOS_REQUEST_TIMEOUT_MS=60000
# Optional bearer token required for /announce.
ANNOUNCE_TOKEN=
# SHUTDOWN_TIMEOUT_MS defaults to two Sonos operation timeouts plus five seconds.
